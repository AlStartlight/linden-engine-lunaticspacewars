  "input": {
    "actions": [
      {
        "name": "Move",
        "type": "vector2",
        "bindings": [
          "Gamepad/LeftStick",
          "Touch/Joystick"
        ],
        "composites": [
          {
            "up": [
              "Keyboard/KeyW"
            ],
            "down": [
              "Keyboard/KeyS"
            ],
            "left": [
              "Keyboard/KeyA"
            ],
            "right": [
              "Keyboard/KeyD"
            ]
          },
          {
            "up": [
              "Keyboard/ArrowUp"
            ],
            "down": [
              "Keyboard/ArrowDown"
            ],
            "left": [
              "Keyboard/ArrowLeft"
            ],
            "right": [
              "Keyboard/ArrowRight"
            ]
          }
        ],
        "deadzone": 0.15
      },
      {
        "name": "Turn",
        "type": "axis",
        "bindings": [],
        "composites": [
          {
            "negative": [
              "Keyboard/KeyQ",
              "Gamepad/LeftShoulder"
            ],
            "positive": [
              "Keyboard/KeyE",
              "Gamepad/RightShoulder"
            ]
          }
        ]
      },
      {
        "name": "Vertical",
        "type": "axis",
        "bindings": [],
        "composites": [
          {
            "negative": [
              "Keyboard/KeyQ",
              "Gamepad/LeftTrigger"
            ],
            "positive": [
              "Keyboard/KeyE",
              "Gamepad/RightTrigger"
            ]
          }
        ]
      },
      {
        "name": "Look",
        "type": "vector2",
        "bindings": [
          "Mouse/Delta",
          "Gamepad/RightStick",
          "Touch/Look"
        ],
        "deadzone": 0.15,
        "sensitivity": 1
      },
      {
        "name": "Jump",
        "type": "button",
        "bindings": [
          "Keyboard/Space",
          "Gamepad/ButtonSouth"
        ]
      },
      {
        "name": "Sprint",
        "type": "button",
        "bindings": [
          "Keyboard/ShiftLeft",
          "Gamepad/LeftStickPress",
          "Touch/Joystick"
        ],
        "pressThreshold": 0.9
      },
      {
        "name": "Crouch",
        "type": "button",
        "bindings": [
          "Keyboard/KeyC",
          "Keyboard/ControlLeft",
          "Gamepad/ButtonEast"
        ]
      },
      {
        "name": "Interact",
        "type": "button",
        "bindings": [
          "Keyboard/KeyF",
          "Gamepad/ButtonWest"
        ]
      },
      {
        "name": "Attack",
        "type": "button",
        "bindings": [
          "Mouse/LeftButton",
          "Gamepad/ButtonNorth",
          "Gamepad/RightTrigger"
        ]
      },
      {
        "name": "FireMissile",
        "type": "button",
        "bindings": [
          "Mouse/RightButton",
          "Gamepad/RightTrigger",
          "Touch/Button/MISSILE",
          "Keyboard/KeyX"
        ]
      },
      {
        "name": "LockTarget",
        "type": "button",
        "bindings": [
          "Keyboard/KeyT",
          "Gamepad/ButtonWest",
          "Touch/Button/LOCK"
        ]
      },
      {
        "name": "Boost",
        "type": "button",
        "bindings": [
          "Keyboard/KeyB",
          "Keyboard/ShiftLeft",
          "Gamepad/LeftStickPress",
          "Touch/Button/BOOST"
        ]
      },
      {
        "name": "Ability",
        "type": "button",
        "bindings": [
          "Keyboard/KeyR",
          "Gamepad/ButtonNorth",
          "Touch/Button/ABILITY"
        ]
      },
      {
        "name": "GalaxyMap",
        "type": "button",
        "bindings": [
          "Keyboard/KeyM",
          "Gamepad/Select",
          "Touch/Button/MAP"
        ]
      },
      {
        "name": "Pause",
        "type": "button",
        "bindings": [
          "Keyboard/Escape",
          "Gamepad/Start"
        ]
      }
    ],
    "touch": {
      "enabled": "auto",
      "joystick": {
        "side": "left",
        "mode": "floating",
        "radius": 64
      },
      "look": {
        "enabled": true,
        "area": "right-half",
        "sensitivity": 1
      },
      "opacity": 0.6,
      "safeArea": true,
      "scale": "auto",
      "buttons": [
        {
          "id": "Jump",
          "action": "Jump",
          "label": "JUMP",
          "icon": "jump",
          "behavior": "hold",
          "anchor": "bottom-right",
          "unit": "px",
          "x": 24,
          "y": 32,
          "size": 72
        },
        {
          "id": "Attack",
          "action": "Attack",
          "label": "ATK",
          "icon": "attack",
          "behavior": "tap",
          "anchor": "bottom-right",
          "unit": "px",
          "x": 112,
          "y": 48,
          "size": 60
        },
        {
          "id": "Sprint",
          "action": "Sprint",
          "label": "RUN",
          "icon": "run",
          "behavior": "hold",
          "anchor": "bottom-right",
          "unit": "px",
          "x": 40,
          "y": 120,
          "size": 52
        },
        {
          "id": "Interact",
          "action": "Interact",
          "label": "USE",
          "icon": "use",
          "behavior": "tap",
          "anchor": "bottom-right",
          "unit": "px",
          "x": 120,
          "y": 128,
          "size": 52
        },
        {
          "id": "TurnLeft",
          "action": "Turn",
          "value": -1,
          "label": "Q",
          "icon": "turn-left",
          "anchor": "bottom-left",
          "unit": "px",
          "x": 24,
          "y": 190,
          "size": 44
        },
        {
          "id": "TurnRight",
          "action": "Turn",
          "label": "E",
          "icon": "turn-right",
          "anchor": "bottom-left",
          "unit": "px",
          "x": 80,
          "y": 190,
          "size": 44
        },
        {
          "id": "MISSILE",
          "action": "FireMissile",
          "label": "MSL",
          "behavior": "tap",
          "cooldown": 2.5,
          "anchor": "bottom-right",
          "unit": "px",
          "x": 180,
          "y": 40,
          "size": 50
        },
        {
          "id": "LOCK",
          "action": "LockTarget",
          "label": "LOCK",
          "behavior": "tap",
          "anchor": "top-right",
          "unit": "px",
          "x": 20,
          "y": 80,
          "size": 46
        },
        {
          "id": "ABILITY",
          "action": "Ability",
          "label": "SKILL",
          "behavior": "tap",
          "cooldown": 8,
          "anchor": "bottom-right",
          "unit": "px",
          "x": 180,
          "y": 115,
          "size": 48
        },
        {
          "id": "MAP",
          "action": "GalaxyMap",
          "label": "MAP",
          "behavior": "tap",
          "anchor": "top-right",
          "unit": "px",
          "x": 80,
          "y": 20,
          "size": 44
        }
      ]
    }
  },
  "services": [],
  "scenesInBuild": [
    "scenes/Main.lscene"
  ],
  "exportPresets": [
    {
      "id": "preset-windows-desktop",
      "name": "Windows Desktop",
      "platform": "windows",
      "backend": "linden",
      "arch": [
        "x64"
      ],
      "output": "build/windows/LunaticSpaceWars.exe",
      "mode": "release",
      "appName": "LunaticSpaceWars"
    },
    {
      "id": "preset-macos-desktop",
      "name": "macOS",
      "platform": "macos",
      "backend": "linden",
      "arch": [
        "universal"
      ],
      "output": "build/mac/LunaticSpaceWars.dmg",
      "mode": "release",
      "appName": "LunaticSpaceWars"
    },
    {
      "id": "preset-linux-desktop",
      "name": "Linux",
      "platform": "linux",
      "backend": "linden",
      "arch": [
        "x64"
      ],
      "output": "build/linux/LunaticSpaceWars.AppImage",
      "mode": "release",
      "appName": "LunaticSpaceWars"
    },
    {
      "id": "preset-web-html5",
      "name": "Web",
      "platform": "web",
      "backend": "linden",
      "arch": [
        "wasm"
      ],
      "output": "build/web/index.html",
      "mode": "release",
      "appName": "LunaticSpaceWars"
    },
    {
      "id": "preset-android",
      "name": "Android",
      "platform": "android",
      "backend": "godot",
      "arch": [
        "arm64"
      ],
      "output": "build/android/LunaticSpaceWars.apk",
      "mode": "debug",
      "appName": "LunaticSpaceWars"
    },
    {
      "id": "preset-ios",
      "name": "iOS",
      "platform": "ios",
      "backend": "godot",
      "arch": [
        "arm64"
      ],
      "output": "build/ios/LunaticSpaceWars.ipa",
      "mode": "debug",
      "appName": "LunaticSpaceWars"
    }
  ]
}